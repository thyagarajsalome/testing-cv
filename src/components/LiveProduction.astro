---
---

<section class="mb-16 relative overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-100 via-indigo-50 to-cyan-50 dark:from-indigo-900 dark:via-indigo-800 dark:to-cyan-900 p-6 shadow-sm animate-on-scroll">
  <!-- Decorative dots pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-4 right-4 w-24 h-24 border border-indigo-200 dark:border-white/20 rounded-full"></div>
    <div class="absolute -bottom-8 -left-8 w-40 h-40 border border-indigo-100 dark:border-white/10 rounded-full"></div>
    <div class="absolute top-1/2 right-1/4 w-16 h-16 border border-indigo-100 dark:border-white/10 rounded-full"></div>
  </div>
  
  <div class="relative flex flex-col md:flex-row md:items-center gap-4">
    <!-- Icon -->
    <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-indigo-100 dark:bg-white/15 flex items-center justify-center">
      <svg class="w-5 h-5 text-indigo-600 dark:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
      </svg>
    </div>
    
    <!-- Text content -->
    <div class="flex-1">
      <h3 class="text-sm font-bold text-indigo-900 dark:text-white mb-1 flex items-center gap-1.5">
        <svg class="w-4 h-4 text-green-500 dark:text-green-300" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        Live in Production
      </h3>
      <p class="text-slate-600 dark:text-white/80 text-sm leading-relaxed max-w-2xl">
        I build and ship <strong class="text-indigo-700 dark:text-white font-semibold">production-grade applications</strong> used by real users worldwide. My React Native app is <strong class="text-indigo-700 dark:text-white font-semibold">live on the Google Play Store</strong> with <strong class="text-indigo-700 dark:text-white font-semibold">5,000+ installs</strong> and growing.
      </p>
      <a href="https://play.google.com/store/apps/details?id=com.aihomedecorator.twa" target="_blank" class="mt-3 inline-flex items-center gap-1.5 px-3 py-1.5 bg-indigo-100 hover:bg-indigo-200 dark:bg-white/15 dark:hover:bg-white/25 rounded-lg text-indigo-700 dark:text-white text-sm font-medium transition-all duration-200 border border-indigo-200 dark:border-white/10">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.807 1.626a1 1 0 010 1.732l-2.807 1.626L15.206 12l2.492-2.492zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z"/></svg>
        View on Google Play
      </a>
    </div>
    
    <!-- Stats badge -->
    <div class="flex-shrink-0 bg-indigo-50 dark:bg-white/10 rounded-xl px-4 py-2.5 text-center border border-indigo-100 dark:border-white/10">
      <div class="text-sm font-extrabold text-indigo-800 dark:text-white">5K+</div>
      <div class="text-xs text-indigo-500 dark:text-white/60 font-medium uppercase tracking-wider">Installs</div>
      <div class="flex items-center justify-center gap-1 mt-0.5 text-green-600 dark:text-green-300 text-xs">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5.293 7.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 5.414V17a1 1 0 11-2 0V5.414L6.707 7.707a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
        </svg>
        Growing
      </div>
    </div>
  </div>
</section>
