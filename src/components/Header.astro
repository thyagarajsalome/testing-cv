<header class="text-center md:text-left md:flex md:justify-between md:items-center mb-16 space-y-6 md:space-y-0">
  <div>
    <h1 class="text-sm font-normal tracking-tight text-slate-900 dark:text-white mb-2">
      Thyagaraja M
    </h1>
    <h2 class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-cyan-500 dark:from-indigo-400 dark:to-cyan-300">
      Full-Stack Developer | Software Architect | AI
    </h2>
  </div>
  <div class="flex flex-col md:items-end text-slate-600 dark:text-slate-400 text-sm md:text-base space-y-2">
    <div class="flex items-center gap-4 mb-2">
      <!-- Dark Mode Toggle -->
      <button id="theme-toggle" class="p-2 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-all duration-200 cursor-pointer" aria-label="Toggle dark mode">
        <!-- Sun icon (shown in dark mode) -->
        <svg class="w-5 h-5 hidden dark:block text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
