      <div class="flex flex-wrap gap-2">
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Google AI Studio</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">AutoCAD</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">3ds Max</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Blender</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Photoshop</span>
      </div>
    </div>
    <div>
      <h4 class="text-sm font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Agentic AI Integration</h4>
      <div class="flex flex-wrap gap-2">
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">ChatGPT</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Gemini</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Claude</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Antigravity</span>
      </div>
    </div>
    <div>
      <h4 class="text-sm font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Promotion & Marketing</h4>
      <div class="space-y-2">
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-700/40 rounded-md text-sm text-green-700 dark:text-green-300 font-semibold">Organic Growth</span>
          <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">App Store Optimization (ASO)</span>
          <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Content Marketing</span>
        </div>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-700/40 rounded-md text-sm text-blue-700 dark:text-blue-300 font-semibold">Paid Ads</span>
          <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Performance Marketing</span>
          <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">User Acquisition (UA)</span>
        </div>
      </div>
    <div>
      <h4 class="text-sm font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Problem Solving</h4>
      <div class="flex flex-wrap gap-2">
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Debugging</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Fixing</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Make It Work</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">MVP Building</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Iterative Development</span>
      </div>
    </div>
    </div>
  </div>
</section>
