<section class="animate-on-scroll">
  <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-6 border-b-2 border-slate-200 dark:border-slate-700 pb-2 inline-block">Technical Arsenal</h3>
  <div class="space-y-4">
    <div>
      <h4 class="text-sm font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Frontend & Languages</h4>
      <div class="flex flex-wrap gap-2">
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">TypeScript</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">React</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Tailwind CSS</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">JavaScript</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">C/C++</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">HTML</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">CSS</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Astro</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Three.js</span>
      </div>
    </div>
    <div>
      <h4 class="text-sm font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Backend & Cloud</h4>
      <div class="flex flex-wrap gap-2">
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Node.js</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Express.js</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Supabase</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">PostgreSQL</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">MySQL</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">GCP</span>
        <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-md text-sm text-slate-700 dark:text-slate-300">Firebase</span>
