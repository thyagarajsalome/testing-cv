---
---

<section class="mb-16">
  <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-3 animate-on-scroll">
    <svg class="w-6 h-6 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
    Featured Projects
  </h3>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    
    <article class="bg-white dark:bg-slate-800/80 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/50 flex flex-col hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group animate-on-scroll delay-100">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-indigo-500 to-cyan-400 flex items-center justify-center text-white font-bold text-sm">AI</div>
        <div>
          <h4 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">AI Home Decorator</h4>
          <p class="text-slate-500 dark:text-slate-400 text-sm">Full-Stack Web & Mobile App</p>
        </div>
      </div>
      <p class="text-slate-600 dark:text-slate-300 mb-4 text-sm leading-relaxed flex-grow">
        An end-to-end spatial design platform using Generative AI (Google AI Studio) for real-time interior transformations via a "Snap, Select, Decorate" workflow. Engineered prompts and API pipelines for seamless image-to-image styling.
      </p>
      
      <div class="flex gap-3 mb-4">
        <a href="https://aihomedecorator.com" target="_blank" class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 flex items-center gap-1">
          Web App <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.aihomedecorator.twa" target="_blank" class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 flex items-center gap-1">
          Mobile App <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
        </a>
      </div>

      <div class="flex flex-wrap gap-2 mt-auto">
        <span class="px-3 py-1 bg-indigo-50 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 rounded-full text-xs font-semibold">React</span>
        <span class="px-3 py-1 bg-blue-50 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-full text-xs font-semibold">TypeScript</span>
        <span class="px-3 py-1 bg-green-50 dark:bg-green-900/40 text-green-700 dark:text-green-300 rounded-full text-xs font-semibold">Supabase</span>
        <span class="px-3 py-1 bg-slate-100 dark:bg-slate-700/50 text-slate-700 dark:text-slate-300 rounded-full text-xs font-semibold">GCP</span>
      </div>
    </article>

    <article class="bg-white dark:bg-slate-800/80 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/50 flex flex-col hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group animate-on-scroll delay-200">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-purple-500 to-pink-400 flex items-center justify-center text-white font-bold text-sm">H</div>
        <div>
          <h4 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">HDE</h4>
          <p class="text-slate-500 dark:text-slate-400 text-sm">SaaS Construction Estimator & Directory</p>
        </div>
      </div>
      <p class="text-slate-600 dark:text-slate-300 mb-4 text-sm leading-relaxed flex-grow">
        A responsive PWA built with a logic-heavy estimation engine that calculates project costs dynamically. Features a custom SPA routing fallback and a robust Professional Directory with automated verification workflows and RBAC.
      </p>
      
      <div class="flex gap-3 mb-4">
        <a href="https://homedesignenglish.com/" target="_blank" class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 flex items-center gap-1">
          Professional Directory <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
      </div>

      <div class="flex flex-wrap gap-2 mt-auto">
        <span class="px-3 py-1 bg-indigo-50 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 rounded-full text-xs font-semibold">React</span>
        <span class="px-3 py-1 bg-blue-50 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-full text-xs font-semibold">TypeScript</span>
        <span class="px-3 py-1 bg-amber-50 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300 rounded-full text-xs font-semibold">Node.js</span>
        <span class="px-3 py-1 bg-green-50 dark:bg-green-900/40 text-green-700 dark:text-green-300 rounded-full text-xs font-semibold">Supabase</span>
      </div>
    </article>

    <article class="bg-white dark:bg-slate-800/80 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/50 flex flex-col hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group animate-on-scroll delay-300">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-yellow-500 to-orange-400 flex items-center justify-center text-white font-bold text-sm">W</div>
        <div>
          <h4 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">Wall Paint AI</h4>
          <p class="text-slate-500 dark:text-slate-400 text-sm">AI Visualization Platform</p>
        </div>
      </div>
      <p class="text-slate-600 dark:text-slate-300 mb-4 text-sm leading-relaxed flex-grow">
        An AI-driven tool for real-time color visualization on architectural surfaces. Achieved realistic color blending using CSS masking techniques combined with AI edge detection, respecting natural room shadows and lighting.
      </p>
      
      <div class="flex gap-3 mb-4">
         <a href="https://wallpaint.in/" target="_blank" class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 flex items-center gap-1">
          Web App <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
      </div>

      <div class="flex flex-wrap gap-2 mt-auto">
        <span class="px-3 py-1 bg-indigo-50 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 rounded-full text-xs font-semibold">React</span>
        <span class="px-3 py-1 bg-blue-50 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-full text-xs font-semibold">TypeScript</span>
        <span class="px-3 py-1 bg-yellow-50 dark:bg-yellow-900/40 text-yellow-700 dark:text-yellow-300 rounded-full text-xs font-semibold">Firebase</span>
      </div>
    </article>

  </div>
    
    <!-- Interactive 3D Section -->
    <div class="col-span-full mt-8 animate-on-scroll">
      <h4 class="text-lg font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"></path></svg>
        Interactive 3D
      </h4>
    </div>
      <article class="bg-white dark:bg-slate-800/80 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700/50 flex flex-col hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group animate-on-scroll">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-cyan-500 to-blue-400 flex items-center justify-center text-white font-bold text-sm">3D</div>
            <div>
              <h4 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">Interactive 3D Projects</h4>
              <p class="text-slate-500 dark:text-slate-400 text-xs">Three.js Experiments & Visualizations</p>
            </div>
          </div>
          <p class="text-slate-600 dark:text-slate-300 mb-4 text-sm leading-relaxed flex-grow">
            A collection of interactive 3D experiments built with Three.js — from product configurators to planetary explorations and classic rendering demos.
          </p>
          <div class="flex flex-col gap-2 mb-4">
            <a href="https://interactive-3dshoe.vercel.app/" target="_blank" class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 flex items-center gap-2 px-3 py-2 bg-indigo-50/50 dark:bg-indigo-900/20 rounded-lg hover:bg-indigo-50 dark:hover:bg-indigo-900/40 transition-all">
              <span class="w-6 h-6 rounded bg-gradient-to-br from-cyan-500 to-blue-400 flex items-center justify-center text-white font-bold text-xs shrink-0">S</span>
              3D Shoe Configurator <svg class="w-4 h-4 ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
            <a href="https://3dplanet.vercel.app/" target="_blank" class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 flex items-center gap-2 px-3 py-2 bg-purple-50/50 dark:bg-purple-900/20 rounded-lg hover:bg-purple-50 dark:hover:bg-purple-900/40 transition-all">
              <span class="w-6 h-6 rounded bg-gradient-to-br from-purple-500 to-indigo-400 flex items-center justify-center text-white font-bold text-xs shrink-0">P</span>
              3D Planet Explorer <svg class="w-4 h-4 ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
            <a href="https://teapot-3d.vercel.app/" target="_blank" class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 flex items-center gap-2 px-3 py-2 bg-rose-50/50 dark:bg-rose-900/20 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-900/40 transition-all">
              <span class="w-6 h-6 rounded bg-gradient-to-br from-rose-500 to-pink-400 flex items-center justify-center text-white font-bold text-xs shrink-0">T</span>
              3D Teapot Viewer <svg class="w-4 h-4 ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
          </div>
          <div class="flex flex-wrap gap-2 mt-auto">
            <span class="px-3 py-1 bg-teal-50 dark:bg-teal-900/40 text-teal-700 dark:text-teal-300 rounded-full text-xs font-semibold">Three.js</span>
            <span class="px-3 py-1 bg-blue-50 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-full text-xs font-semibold">JavaScript</span>
            <span class="px-3 py-1 bg-cyan-50 dark:bg-cyan-900/40 text-cyan-700 dark:text-cyan-300 rounded-full text-xs font-semibold">WebGL</span>
          </div>
        </article>
</section>
